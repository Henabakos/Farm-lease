# ============================================================================
# Farm Lease — Backend Environment
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug                 # trace|debug|info|warn|error|fatal

# --- Frontend / API URLs ---------------------------------------------------
CLIENT_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001/api

# --- PostgreSQL (Prisma) ---------------------------------------------------
# Local dev (via docker compose): postgres:postgres@localhost:5433/farm_lease
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/farm_lease?schema=public"
# Shadow DB disabled for local development with pgvector
SHADOW_DATABASE_URL=""

# --- Redis -----------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- JWT / Auth ------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access-secret-min-64-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-64-chars"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_RESET_TTL=30m
EMAIL_VERIFY_TTL=24h
# When true, new non-admin users require admin approval before login is allowed
REQUIRE_ADMIN_APPROVAL=false

# --- Object Storage (MinIO / S3) ------------------------------------------
STORAGE_DRIVER=minio            # minio | s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=farm-lease
S3_FORCE_PATH_STYLE=true

# --- Mailer ----------------------------------------------------------------
MAIL_DRIVER=smtp                # smtp | resend
MAIL_FROM="Farm Lease <no-reply@farmlease.local>"
SMTP_HOST=localhost
SMTP_PORT=1025                  # mailhog
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# --- AI / RAG --------------------------------------------------------------
AI_LLM_PROVIDER=lmstudio        # openai | gemini | ollama | lmstudio
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LMSTUDIO_HOST=http://localhost:1234/v1
LMSTUDIO_CHAT_MODEL=Meta-Llama-3.1-8B-Instruct
LMSTUDIO_EMBEDDING_MODEL=nomic-embed-text-v1.5

# --- External Integrations -------------------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=your-zoom-webhook-secret-random-string

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Rate limiting (per IP/user, requests per window) ---------------------
RATE_LIMIT_GLOBAL_RPM=100
RATE_LIMIT_AUTH_RPM=10
RATE_LIMIT_AI_RPM=30
